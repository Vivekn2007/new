{
  "version": 2,
  "functions": {
    "main.js": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/output.css",
      "dest": "/public/output.css"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "/public/fonts/$1"
    },
    {
      "src": "/(.*)",
      "dest": "main.js"
    }
  ]
}